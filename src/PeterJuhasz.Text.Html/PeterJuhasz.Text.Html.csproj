<Project Sdk="Microsoft.NET.Sdk">
	
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<RootNamespace>PeterJuhasz.Text.Html</RootNamespace>
	</PropertyGroup>

	<PropertyGroup>
		<VersionPrefix>1.1.0</VersionPrefix>
		<PackageId>PeterJuhasz.Text.Html</PackageId>
		<PackageTags>html</PackageTags>
		<PackageProjectUrl>https://github.com/Peter-Juhasz/html</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Peter-Juhasz/html</RepositoryUrl>
	</PropertyGroup>
	
	<PropertyGroup>
		<IsTrimmable>true</IsTrimmable>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<InvariantGlobalization>true</InvariantGlobalization>
		<EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
		<EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
		<WarningsNotAsErrors>IL2026</WarningsNotAsErrors>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration) == 'Release'">
		<TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="PeterJuhasz.Extensions" Version="2.*-*" />
	</ItemGroup>

</Project>
